    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "node-fetch": "^2.7.0",
    "sql.js": "^1.14.2"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "ngrok": "^5.0.0-beta.2",
    "nodemon": "^3.1.7"
  },
  "allowScripts": {
    "better-sqlite3@11.10.0": true,
    "ngrok@5.0.0-beta.2": true
  }
