{
  "name": "restorecord-bot",
  "version": "1.0.0",
  "description": "Discord server verification & recovery bot",
  "main": "src/bot/index.js",
  "scripts": {
    "start": "node start.js",
    "bot": "node src/bot/index.js",
    "web": "node src/web/index.js",
    "tunnel": "node tunnel.js",
