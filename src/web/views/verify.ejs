<!DOCTYPE html>
<html lang="fr">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Vérification - RestoreBot</title>
  <link rel="stylesheet" href="/css/style.css">
  <style>
    body { background: #0d1117; }
    .verify-container {
      display: flex;
      justify-content: center;
      align-items: center;
      min-height: 100vh;
    }
    .verify-card {
      background: #161b22;
      border: 1px solid #30363d;
      border-radius: 16px;
      padding: 48px;
      text-align: center;
      max-width: 440px;
      width: 90%;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    .verify-card h1 {
      color: #f0f6fc;
      font-size: 24px;
      margin: 16px 0 8px;
    }
    .verify-card p {
      color: #8b949e;
      margin-bottom: 32px;
      line-height: 1.6;
    }
    .verify-icon {
      font-size: 64px;
      margin-bottom: 8px;
    }
    .btn-verify {
      display: inline-flex;
      align-items: center;
      gap: 10px;
      background: #5865f2;
      color: white;
      padding: 14px 32px;
      border-radius: 8px;
      text-decoration: none;
      font-size: 18px;
      font-weight: 600;
      transition: background 0.2s;
    }
    .btn-verify:hover { background: #4752c4; }
    .success-icon { color: #57f287; }
    .error-icon { color: #ed4245; }
    .error-box {
      background: rgba(237,66,69,0.1);
      border: 1px solid rgba(237,66,69,0.3);
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 24px;
      color: #ed4245;
    }
    .success-box {
      background: rgba(87,242,135,0.1);
      border: 1px solid rgba(87,242,135,0.3);
      border-radius: 8px;
      padding: 16px;
      margin-bottom: 24px;
      color: #57f287;
    }
  </style>
</head>
<body>
  <div class="verify-container">
    <div class="verify-card">
      <% if (success) { %>
        <div class="verify-icon success-icon">✅</div>
        <h1>Vérification réussie !</h1>
        <p>Bonjour <%= username %> ! Vous avez été vérifié avec succès.<br>Vous pouvez maintenant accéder à tout le serveur.</p>
        <a href="https://discord.com/channels/<%= guildId %>" class="btn-verify">Retour au serveur</a>
      <% } else if (error) { %>
        <div class="verify-icon error-icon">❌</div>
        <h1>Erreur de vérification</h1>
        <div class="error-box"><%= error %></div>
        <a href="/verify/<%= guildId %>" class="btn-verify">Réessayer</a>
      <% } else { %>
        <div class="verify-icon">🛡️</div>
        <h1>Vérification</h1>
        <p>Pour accéder à ce serveur, vous devez vous vérifier via Discord OAuth2.<br>Cliquez sur le bouton ci-dessous pour commencer.</p>
        <a href="https://discord.com/api/oauth2/authorize?client_id=<%= config.bot.clientId %>&redirect_uri=<%= encodeURIComponent(config.web.url + '/verify/callback') %>&response_type=code&scope=identify+guilds.join&state=<%= guildId %>" class="btn-verify">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="white"><path d="M20.317 4.37a19.791 19.791 0 0 0-4.885-1.515.074.074 0 0 0-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 0 0-5.487 0 12.64 12.64 0 0 0-.617-1.25.077.077 0 0 0-.079-.037A19.736 19.736 0 0 0 3.677 4.37a.07.07 0 0 0-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 0 0 .031.057 19.9 19.9 0 0 0 5.993 3.03.078.078 0 0 0 .084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 0 0-.041-.106 13.107 13.107 0 0 1-1.872-.892.077.077 0 0 1-.008-.128 10.2 10.2 0 0 0 .372-.292.074.074 0 0 1 .077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 0 1 .078.01c.12.098.246.198.373.292a.077.077 0 0 1-.006.127 12.299 12.299 0 0 1-1.873.892.077.077 0 0 0-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 0 0 .084.028 19.839 19.839 0 0 0 6.002-3.03.077.077 0 0 0 .032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 0 0-.031-.03z"/></svg>
          Vérifier avec Discord
        </a>
      <% } %>
    </div>
  </div>
</body>
</html>
